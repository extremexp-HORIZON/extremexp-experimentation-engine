task Task2 {

    type interactive;
    // for interactive tasks, Python 3.6.9 is used and cannot be changed

    define input data dataframe_json;
    define output data dataframe_json;

    implementation "Task2/task.py";
    venv "Task2/requirements.txt";

    define metric TestUserAction {
        kind single-value;
        type string;
    }
}
