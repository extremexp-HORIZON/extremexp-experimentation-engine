task TrainModelRNN {

    define input data XPad;
    define input data YPad;
    define input data FeaturesTrain;
    define input data LabelsTrain;
    define input data LabelsTest;
    define input data FeaturesTest;
    define output data OutputFolder;

    implementation "IDEKO/TrainModelRNN/task.py";

    define param epochs {
        type Integer;
        default 90;
        range [1,200];
    }

    define param batch_size {
        type Integer;
        default 64;
        range [8,256];
    }
}
