workflow ComplexControlWorkflow {

    task Task1 {
        implementation "Testcase_task1";
    }

    task Task2;

     START -> Task1 -> Task2 -> END;

}

workflow ComplexControlAW1 from ComplexControlWorkflow {
    task Task2 {
        implementation "Testcase_task2_v1";
    }
}

workflow ComplexControlAW2 from ComplexControlWorkflow {
    task Task2 {
        implementation "Testcase_task2_v2";
    }
}

experiment ComplexControlExp1 {
    intent testComplexControl;

    control {
          S1 ?-> S2 { condition "check_results_less_than 100" };
          S2 -> T1;
    }

    space S1 of ComplexControlAW1 {
        strategy randomsearch;
        runs = 1;
        param_values param1_vp = enum(2, 5, 7);
        task Task1 {
            param param1 = param1_vp;
        }
    }

    space S2 of ComplexControlAW2 {
        strategy gridsearch;
        param_values param1_vp = range(3, 4);
        task Task1 {
            param param1 = param1_vp;
        }
    }

    space S3 of ComplexControlAW2 {
        strategy gridsearch;
        param_values param1_vp = range(4, 5);
        task Task1 {
            param param1 = param1_vp;
        }
    }

    task T1 {
        implementation "ExpTask1";
        input data T1InputFile {
            path "tests/dummy.txt";
        }
    }

    task T2 {
        implementation "ExpTask1";
    }

    interaction I1 {
        implementation "ExpInteraction1";
    }

}
