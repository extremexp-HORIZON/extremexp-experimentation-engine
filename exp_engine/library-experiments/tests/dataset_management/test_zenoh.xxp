workflow SingleTaskW {

    START -> Task1 -> Task2 -> END;

    task Task1 {
        implementation "TestDatasetManagementTask1";
    }

    task Task2 {
        implementation "TestDatasetManagementTask2";
    }

    define input data InputFile;
    configure data InputFile {
        name "titanic.json";
        project "demo_project_ilias";
    }

    define output data OutputFile;
    configure data OutputFile {
        name "titanic_once_more.json";
    }

    InputFile --> Task1.TestDatasetManagementTask1InputFile;
    Task1.TestDatasetManagementTask1OutputFile --> Task2.TestDatasetManagementTask2InputFile;
    Task2.TestDatasetManagementTask2OutputFile --> OutputFile;

}

workflow SingleTaskAW from SingleTaskW {
}

experiment TestZenohExp {

    control {
          START -> S1 -> END;
    }

    space S1 of SingleTaskAW {
        strategy gridsearch;
    }

}
