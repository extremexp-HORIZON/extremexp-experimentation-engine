workflow DemoWorkflow {

    START -> Task1 -> END;

    task Task1 {
        implementation "demo_tasks/demo";
    }

}

workflow DemoWP5AssembledWorkflow1 from DemoWorkflow {

}

experiment DemoWP5Experiment {

    control {
          START -> S1 -> END;
    }

    space S1 of DemoWP5AssembledWorkflow1 {
        strategy gridsearch;
        param_values demo_param_value = enum(4);
        task Task1 {
            param demo_param = demo_param_value;
        }
    }
}