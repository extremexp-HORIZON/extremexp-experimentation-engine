workflow DemoWorkflow {

    START -> Task1 -> Task2 -> END;

    task Task1 {
        implementation "kubeflow_tests/simple_two_tasks/task1";
    }
    
    task Task2 {
        implementation "kubeflow_tests/simple_two_tasks/task2";
    }

}

workflow DemoWP5AssembledWorkflow1 from DemoWorkflow {

}

experiment DemoWP5Experiment {

    control {
        S1 ?-> S2 {condition "check_results 100"};
    }

    space S1 of DemoWP5AssembledWorkflow1 {
        strategy gridsearch;
        param_values demo_param_value = enum(4);
        task Task1 {
            param demo_param = demo_param_value;
        }
    }
    
    space S2 of DemoWP5AssembledWorkflow1 {
        strategy gridsearch;
        param_values demo_param_value = enum(4);
        task Task1 {
            param demo_param = demo_param_value;
        }
    }
}