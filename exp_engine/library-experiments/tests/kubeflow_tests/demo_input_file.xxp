workflow DemoWorkflow {

    START -> Task1 -> Task2 -> END;

    task Task1 {
        implementation "kubeflow_tests/simple_two_tasks_input_file/task1";
    }
    
    task Task2 {
        implementation "kubeflow_tests/simple_two_tasks_input_file/task2";
    }

    efine input data InputFile;
    configure data InputFile {
        path "demo_datasets/titanic.csv";
    }

    InputFile --> Task1.task1inputfile

}

workflow DemoWP5AssembledWorkflow1 from DemoWorkflow {

}

experiment DemoWP5Experiment {

    control {
          START -> S1 -> END;
    }

    space S1 of DemoWP5AssembledWorkflow1 {
        strategy gridsearch;
        param_values demo_param_value = enum(4);
        task Task1 {
            param demo_param = demo_param_value;
        }
    }
}