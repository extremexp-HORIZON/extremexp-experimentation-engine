workflow SingleTaskW {

    START -> Task1 -> Task2 -> Task3 -> END;

    task Task1 {
        implementation "TestDatasetManagementTask1";
    }

    task Task2 {
        implementation "TestDatasetManagementTask2";
    }

    task Task3 {
        implementation "TestDatasetManagementTask3";
    }

    define input data InputFile;
    configure data InputFile {
        name "titanic.csv";
        project "test_project";
    }

    define output data OutputFile;
    configure data OutputFile {
        name "titanic_once_more.csv";
    }

    InputFile --> Task1.TestDatasetManagementTask1InputFile;
    Task1.TestDatasetManagementTask1OutputFile --> Task3.TestDatasetManagementTask3InputFile;
    Task3.TestDatasetManagementTask3OutputFile --> OutputFile;

}

workflow SingleTaskAW from SingleTaskW {
}